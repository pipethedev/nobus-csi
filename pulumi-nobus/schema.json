{
  "name": "nobus",
  "displayName": "Nobus",
  "version": "0.1.0",
  "description": "A Pulumi provider for Nobus Cloud (servers, SSH keys, volumes, networking).",
  "keywords": [
    "pulumi",
    "nobus",
    "cloud",
    "category/cloud",
    "kind/native"
  ],
  "homepage": "https://cloud.nobus.io",
  "license": "Apache-2.0",
  "repository": "https://github.com/brimble/pulumi-nobus",
  "pluginDownloadURL": "github://api.github.com/brimble/pulumi-nobus",
  "publisher": "brimble",
  "meta": {
    "moduleFormat": "(.*)"
  },
  "config": {
    "variables": {
      "apiKey": {
        "type": "string",
        "description": "Nobus API key (Bearer token).",
        "default": "",
        "defaultInfo": {
          "environment": [
            "NOBUS_API_KEY"
          ]
        },
        "secret": true
      },
      "availabilityZone": {
        "type": "string",
        "description": "Optional default availability zone. Prefer setting availabilityZone on each resource (required) — Nobus has multiple AZs.",
        "default": "",
        "defaultInfo": {
          "environment": [
            "NOBUS_AVAILABILITY_ZONE"
          ]
        }
      },
      "endpoint": {
        "type": "string",
        "description": "Nobus API endpoint.",
        "default": "https://cloud-api.nobus.io",
        "defaultInfo": {
          "environment": [
            "NOBUS_ENDPOINT"
          ]
        }
      },
      "projectId": {
        "type": "string",
        "description": "Default project ID when a resource omits projectId.",
        "default": "",
        "defaultInfo": {
          "environment": [
            "NOBUS_PROJECT_ID"
          ]
        }
      }
    },
    "defaults": [
      "apiKey"
    ]
  },
